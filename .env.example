# ========================================
# REQUIRED - Application won't work without these
# ========================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Must be from the same organization/project as your Agent Builder workflow
OPENAI_API_KEY=

# ChatKit Workflow ID
# 1. Go to: https://platform.openai.com/agent-builder
# 2. Create or select a workflow
# 3. Click "Publish" to get your Workflow ID (starts with "wf_")
NEXT_PUBLIC_WORKFLOW_ID=

# ChatKit Domain Key
# 1. Go to: https://platform.openai.com/settings/organization/domain-allowlist
# 2. Click "Add Domain" and enter your domain:
#    - For local development: localhost
#    - For Cloud Run: your-app-name.run.app
#    - For custom domain: yourdomain.com
# 3. After adding, you'll receive a domain key (starts with "domain_pk_")
# 4. Copy that value here
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=

# ========================================
# REQUIRED FOR SMS - Skip if testing web-only
# ========================================

# Twilio Account SID
# Get from: https://console.twilio.com/ → Account Info
TWILIO_ACCOUNT_SID=

# Twilio API Key Credentials (Required for sending SMS)
# These provide more secure authentication than using your Auth Token
# To create:
# 1. Go to: https://console.twilio.com/
# 2. Navigate to: Account → API keys & tokens
# 3. Click "Create API Key"
# 4. Copy the SID and Secret (you won't be able to see the Secret again!)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Twilio Phone Number (E.164 format)
# Your Twilio phone number that will send/receive SMS
# Format: +1234567890
TWILIO_PHONE_NUMBER=

# ========================================
# OPTIONAL - Has sensible defaults
# ========================================

# Application URL
# Set this to your deployed URL for production webhooks
# Leave empty for local development
# Example: https://your-app-name.run.app
APP_URL=

# VNC Password (For Docker virtual display debugging)
# Only used when running with docker-compose.virtual-display.yml
VNC_PASSWORD=password

# Node Environment
# Automatically set by deployment platform
# NODE_ENV=production

# Server Port
# Cloud Run requires port 8080 in production
# Local development uses 3000
# PORT=3000
